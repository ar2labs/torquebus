# SPDX-License-Identifier: GPL-3.0-or-later
#
# Enforces, mechanically, the parts of docs/ARCHITECTURE.md a compiler cannot:
# no owning raw pointers in new code, no implicit conversions on the frame
# pipeline, no accidental copies of large structures.
#
# This file was written early and did not run until much later - CI never
# executed, and the "static analysis" step in it was an echo. The first real
# run, with clang-tidy 21 over all 95 of our translation units, found the
# defect that src/core/ThreadGuard.h now covers: four thread entry points and
# two destructors from which an exception could escape, every one of them a
# std::terminate rather than an error.
#
# To run it:
#
#   clang-tidy -p build/windows-msvc-strict --quiet #       --extra-arg=-Wno-unused-command-line-argument <file.cpp>
#
# The extra argument is needed because the compilation database carries MSVC's
# /Zc:preprocessor, which clang accepts and does not use; without it every file
# reports an error before any check runs.

# A note on -misc-include-cleaner, which is the one exclusion that needs one:
# it postdates this file, and it wants every symbol's header included directly -
# 45,000 findings on the first run, of which the interesting ones were none. It
# is also wrong often enough to cost more than it returns, reporting symbols
# that do arrive through a header the file includes on purpose.
#
# The note lives here and not beside the entry, and that is not a style
# preference. `Checks:` below is a folded block scalar: everything indented
# under it is literal text, so a `#` line in there is not a comment - it becomes
# part of the comma-separated list and takes the entry after it with it. Written
# that way once, the exclusion silently did nothing and include-cleaner went on
# reporting. The evidence was a run that still showed 199 of them.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements

WarningsAsErrors: ''
HeaderFilterRegex: 'src/.*\.h$'
FormatStyle: file

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '30'
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'CanFrame'
