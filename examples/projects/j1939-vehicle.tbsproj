            {
                "id": "j1939_test",
                "parameters": {
                    "channel": 0,
                    "script": "-- J1939 & UDS automated verification sequence\n\ntest(\"EEC1 engine speed cyclic broadcast (0x0CF00400)\", function()\n    local frame = expect_frame(0x0CF00400, { within = 500 })\n    assert_equal(#frame.data, 8, \"EEC1 DLC\")\nend)\n\ntest(\"EEC1 engine speed and torque signal validity\", function()\n    local frame = expect_frame(0x0CF00400, { within = 500 })\n    local raw_rpm = frame.data:byte(4) + frame.data:byte(5) * 256\n    assert_true(raw_rpm <= 64255, \"EngineSpeed raw value is valid\")\nend)\n\ntest(\"UDS 0x10 DiagnosticSessionControl on EMS (0x7E0/0x7E8)\", function()\n    send(0x7E0, \"\\x02\\x10\\x01\\x55\\x55\\x55\\x55\\x55\")\n    local answer = expect(0x7E8, { within = 500 })\n    assert_true(answer ~= nil, \"EMS answered within 500 ms\")\n    assert_equal(answer.data:byte(2), 0x50, \"positive response SID 0x50\")\nend)\n\ntest(\"UDS 0x22 ReadDataByIdentifier Coolant DID 0x0105\", function()\n    send(0x7E0, \"\\x03\\x22\\x01\\x05\\x55\\x55\\x55\\x55\")\n    local answer = expect(0x7E8, { within = 500 })\n    assert_true(answer ~= nil, \"EMS answered DID 0x0105 within 500 ms\")\n    assert_equal(answer.data:byte(2), 0x62, \"positive response SID 0x62\")\nend)\n"
                },
                "position": {
                    "x": 822,
                    "y": 212
                },
                "type": "lua.test"
            },
